{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubiqsmart.com/schemas/networks.schema.json",
  "title": "Ubiq network metadata",
  "type": "object",
  "required": ["generatedAt", "networks"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date" },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "shortName",
          "chainId",
          "networkId",
          "nativeCurrency",
          "genesisHash",
          "rpc",
          "explorers"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "chainId": { "type": "integer", "minimum": 1 },
          "networkId": { "type": "integer", "minimum": 1 },
          "nativeCurrency": {
            "type": "object",
            "required": ["name", "symbol", "decimals"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "symbol": { "type": "string", "pattern": "^[A-Z0-9]+$" },
              "decimals": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "additionalProperties": false
          },
          "genesisHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "rpc": {
            "type": "array",
            "items": { "$ref": "#/$defs/service" }
          },
          "explorers": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/service" },
                {
                  "type": "object",
                  "required": ["name"]
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["url", "status"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "status": {
          "enum": [
            "observed-working",
            "observed-working-unverified",
            "observed-dns-failure",
            "unverified"
          ]
        },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
